{
  "name": "classin-edb-reports-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:migrations": "node scripts/test_migrations_local.mjs",
    "build:check": "wrangler deploy --dry-run",
    "check": "npm test && npm run test:migrations && npm run build:check",
    "predeploy": "npm run check",
    "deploy": "node scripts/deploy_remote.mjs",
    "predeploy:migrations-only": "npm run check",
    "deploy:migrations-only": "node scripts/deploy_remote.mjs --migrate-only",
    "verify:pre-migration:remote": "node scripts/verify_deployment.mjs --remote --phase pre-migration",
    "verify:schema:remote": "node scripts/verify_deployment.mjs --remote --phase schema",
    "verify:deploy:remote": "node scripts/verify_deployment.mjs --remote --phase post",
    "verify:deploy:local": "node scripts/verify_deployment.mjs --local --phase schema",
    "db:create": "wrangler d1 create classin-edb-reports",
    "db:migrate:local": "wrangler d1 migrations apply classin-edb-reports --local",
    "db:migrate:remote": "npm run deploy:migrations-only"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  }
}
